# Documentation only: run.sh reads process environment, does not source this file.
AIC_PORT=8000
AIC_STATE_DIR=storage/state
AIC_STORAGE_DIR=storage
AIC_PUBLIC_DATA_DIR=storage/datasets/public
AIC_STATIC_DIR=frontend/dist
AIC_AI_URL=http://127.0.0.1:8081/v1/chat/completions
# Set to the checked-out Git SHA when starting a verified build.
AIC_SOURCE_COMMIT=
OMP_NUM_THREADS=2
OPENBLAS_NUM_THREADS=2
MKL_NUM_THREADS=2
NUMEXPR_NUM_THREADS=2

# Loopback HTTP preview: 0. Approved HTTPS deployment MUST use 1.
AIC_COOKIE_SECURE=0
